      "id": "24b8e0eb-65f2-4f81-868e-635019512cbc",
      "name": "1. 查詢公司 API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -976,
        128
      ]
