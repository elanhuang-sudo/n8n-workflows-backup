      "parameters": {
        "jsCode": "// 民國年轉西元年函式 (YYYMMDD -> YYYY-MM-DD)\nfunction convertRocDate(rocStr) {\n  if (!rocStr || typeof rocStr !== 'string') return '';\n  const trimmed = rocStr.trim();\n  if (trimmed.length !== 7) return trimmed;\n  const year = parseInt(trimmed.substring(0, 3), 10) + 1911;\n  const month = trimmed.substring(3, 5);\n  const day = trimmed.substring(5, 7);\n  return `${year}-${month}-${day}`;\n}\n\n// 走訪 n8n 傳進來的所有項目 (Items)\nreturn $input.all().map((item, index) => {\n  // 取得 API 回傳的 JSON (若為陣列則抓第一筆，否則直接使用該物件)\n  const apiData = Array.isArray(item.json) ? item.json[0] : item.json;\n  \n  // 透過索引自動對應 Split Out 切出來的原統編 (若抓不到則嘗試讀取 Sheet 節點)\n  const splitItem = $('Split Out2').all()[index]?.json || {};\n  const sheetItem = $('讀取商業統編列表').all()[index]?.json || {};\n  const rowNumber = sheetItem.row_number || splitItem.row_number;\n  const originalTaxId = splitItem['統編'] || splitItem['[\"統編\"]'] || sheetItem['統編'] || '';\n\n  // 判斷是否有查到商業資料\n  if (apiData && apiData.Business_Name) {\n    return {\n      json: {\n        row_number: rowNumber,\n        '統編': apiData.President_No || originalTaxId,\n        '組織類型': apiData.Business_Organization_Type_Desc || '商業行號',\n        '公司名稱': apiData.Business_Name || '',\n        '負責人': apiData.Responsible_Name || '',\n        '地址': apiData.Business_Address || '',\n        '設立日期': convertRocDate(apiData.Business_Setup_Approve_Date),\n        '狀態': apiData.Business_Current_Status_Desc || '',\n        '到期日': '' // 商業 API 通常無停業到期日欄位，預設給空白保持欄位結構一致\n      }\n    };\n  } else {\n    // 查無商業資料\n    return {\n      json: {\n        row_number: rowNumber,\n        '統編': originalTaxId,\n        '組織類型': '查無商業資料',\n        '公司名稱': '',\n        '負責人': '',\n        '地址': '',\n        '設立日期': '',\n        '狀態': '',\n        '到期日': ''\n      }\n    };\n  }\n});"
      },
