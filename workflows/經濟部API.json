        "jsCode": "// 民國年轉西元年函式 (YYYMMDD -> YYYY-MM-DD)\nfunction convertRocDate(rocStr) {\n  if (!rocStr || typeof rocStr !== 'string') return '';\n  const trimmed = rocStr.trim();\n  if (trimmed.length !== 7) return trimmed;\n  const year = parseInt(trimmed.substring(0, 3), 10) + 1911;\n  const month = trimmed.substring(3, 5);\n  const day = trimmed.substring(5, 7);\n  return `${year}-${month}-${day}`;\n}\n\n// 走訪所有 API 回傳項目\nreturn $input.all().map((item, index) => {\n  const apiData = Array.isArray(item.json) ? item.json[0] : item.json;\n\n  // 防錯模式取得原始 Sheet 資料\n  let splitItem = {};\n  try {\n    splitItem = $('Split Out (分公司)').all()[index]?.json || {};\n  } catch (e) {}\n  let sheetItem = {};\n  try {\n    sheetItem = $('讀取分公司統編列表').all()[index]?.json || {};\n  } catch (e) {}\n  const rowNumber = apiData?.row_number || splitItem.row_number || sheetItem.row_number || (index + 1);\n  const originalTaxId = apiData?.Branch_Office_Business_Accounting_NO || splitItem['總公司統編'] || sheetItem['總公司統編'] || '';\n\n  // 判斷是否有查到分公司資料\n  if (apiData && apiData.Branch_Office_Name) {\n    return {\n      json: {\n        row_number: rowNumber,\n        '統編': apiData.Branch_Office_Business_Accounting_NO || originalTaxId,\n        '組織類型': '分公司',\n        '公司名稱': apiData.Branch_Office_Name || '',\n        '總公司統編': apiData.Business_Accounting_NO || '',\n        '負責人': apiData.Branch_Office_Manager_Name || '',\n        '地址': apiData.Branch_Office_Location || '',\n        '設立日期': convertRocDate(apiData.BR_ESTAB_DATE),\n        '最後變更日期': convertRocDate(apiData.CHG_APP_DATE),\n        '狀態': apiData.Branch_Office_Status_Desc || ''\n      }\n    };\n  } else {\n    // 查無分公司資料\n    return {\n      json: {\n        row_number: rowNumber,\n        '統編': originalTaxId,\n        '組織類型': '查無分公司資料',\n        '公司名稱': '',\n        '總公司統編': '',\n        '負責人': '',\n        '地址': '',\n        '設立日期': '',\n        '最後變更日期': '',\n        '狀態': ''\n      }\n    };\n  }\n});"
      },
