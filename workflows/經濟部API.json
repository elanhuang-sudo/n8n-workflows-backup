    {
      "parameters": {
        "jsCode": "// 民國年轉西元年函式 (YYYMMDD -> YYYY-MM-DD)\nfunction convertRocDate(rocStr) {\n  if (!rocStr || typeof rocStr !== 'string') return '';\n  const trimmed = rocStr.trim();\n  if (trimmed.length !== 7) return trimmed;\n  const year = parseInt(trimmed.substring(0, 3), 10) + 1911;\n  const month = trimmed.substring(3, 5);\n  const day = trimmed.substring(5, 7);\n  return `${year}-${month}-${day}`;\n}\n\n// 走訪 n8n 傳進來的所有項目 (Items)\nreturn $input.all().map((item, index) => {\n  // 取得 API 回傳的 JSON (若為陣列則抓第一筆，否則直接使用該物件)\n  const apiData = Array.isArray(item.json) ? item.json[0] : item.json;\n  \n  // 透過索引自動對應 Split Out 切出來的原統編 (若抓不到則嘗試讀取 Sheet 節點)\n  const splitItem = $('Split Out').all()[index]?.json || {};\n  const sheetItem = $('讀取公司統編列表').all()[index]?.json || {};\n  const rowNumber = sheetItem.row_number || splitItem.row_number;\n  const originalTaxId = splitItem['統編'] || sheetItem['統編'] || '';\n\n  // 判斷是否有查到公司資料\n  if (apiData && apiData.Company_Name) {\n    // 狀態優先取 Case_Status_Desc，若無則帶 Company_Status_Desc\n    const statusDesc = (apiData.Case_Status_Desc && apiData.Case_Status_Desc.trim()) \n      ? apiData.Case_Status_Desc.trim() \n      : (apiData.Company_Status_Desc || '');\n\n    return {\n      json: {\n        row_number: rowNumber,\n        '統編': apiData.Business_Accounting_NO || originalTaxId,\n        '組織類型': '公司',\n        '公司名稱': apiData.Company_Name || '',\n        '負責人': apiData.Responsible_Name || '',\n        '地址': apiData.Company_Location || '',\n        '設立日期': convertRocDate(apiData.Company_Setup_Date),\n        '狀態': statusDesc,\n        '到期日': convertRocDate(apiData.Sus_End_Date)\n      }\n    };\n  } else {\n    // 查無公司資料\n    return {\n      json: {\n        row_number: rowNumber,\n        '統編': originalTaxId,\n        '組織類型': '查無公司資料',\n        '公司名稱': '',\n        '負責人': '',\n        '地址': '',\n        '設立日期': '',\n        '狀態': '',\n        '到期日': ''\n      }\n    };\n  }\n});"
      },
