    {
      "parameters": {
        "jsCode": "// 1. 取得上一個節點的資料\nconst input = items[0].json;\nconst clients = input[\"客戶名稱\"] || [];\n// 這裡將 Key 修改為你 JSON 中的「客戶資料夾」\nconst links = input[\"客戶資料夾\"] || [];\n\n// 2. 動態生成按鈕陣列\nconst buttons = clients.map((name, index) => {\n  return {\n    \"type\": \"button\",\n    \"action\": {\n      \"type\": \"uri\",\n      \"label\": name.substring(0, 40), // LINE 限制標籤最多 40 字\n      \"uri\": encodeURI(links[index]) // 確保網址編碼正確\n    },\n    \"style\": \"primary\",\n    \"margin\": \"sm\"\n  };\n});\n\n// 3. 組裝 Flex Message 結構\nconst flexContent = {\n  \"type\": \"bubble\",\n  \"header\": {\n    \"type\": \"box\",\n    \"layout\": \"vertical\",\n    \"contents\": [\n      {\n        \"type\": \"text\",\n        \"text\": \"📁 客戶資料夾存取\",\n        \"weight\": \"bold\",\n        \"size\": \"lg\",\n        \"color\": \"#1DB446\"\n      }\n    ]\n  },\n  \"body\": {\n    \"type\": \"box\",\n    \"layout\": \"vertical\",\n    \"contents\": [\n      {\n        \"type\": \"text\",\n        \"text\": \"請選擇下方單位以查看資料夾：\",\n        \"size\": \"sm\",\n        \"color\": \"#666666\",\n        \"wrap\": true\n      },\n      ...buttons\n    ]\n  }\n};\n\n// 4. 輸出字串化後的 JSON 給 Line 節點使用\nreturn {\n  flexJsonString: JSON.stringify(flexContent)\n};"
      },
