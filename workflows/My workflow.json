    {
      "parameters": {
        "jsCode": "// 1. 設定 7 位指定專員名單\nconst uniqueData = [\n  { name: \"王淑娥 分機111\", link: \"https://g.kscpb.com/ks111\" },\n  { name: \"黃紋綺 分機112\", link: \"https://g.kscpb.com/ks112\" },\n  { name: \"張玉幸 分機113\", link: \"https://g.kscpb.com/ks113\" },\n  { name: \"余秋萍 分機115\", link: \"https://g.kscpb.com/ks115\" },\n  { name: \"周佳玲 分機116\", link: \"https://g.kscpb.com/ks116\" },\n  { name: \"黎依婷 分機117\", link: \"https://g.kscpb.com/ks117\" },\n  { name: \"黃鈞煜 分機122\", link: \"https://g.kscpb.com/ks122\" }\n];\n\nconst listContents = [];\n\nuniqueData.forEach((person, index) => {\n  let serviceType = person.name.includes(\"黃鈞煜\") ? \"設立變更登記\" : \"帳務處理、發票查詢\";\n\n  // 每位專員區塊：水平佈局\n  listContents.push({\n    \"type\": \"box\",\n    \"layout\": \"horizontal\",\n    \"contents\": [\n      {\n        \"type\": \"box\",\n        \"layout\": \"vertical\",\n        \"flex\": 2, // 調整比例讓大字有足夠空間\n        \"contents\": [\n          {\n            \"type\": \"text\",\n            \"text\": person.name,\n            \"weight\": \"bold\",\n            \"size\": \"lg\", // 姓名放大至 lg\n            \"color\": \"#333333\",\n            \"wrap\": true\n          },\n          {\n            \"type\": \"text\",\n            \"text\": serviceType,\n            \"size\": \"xs\",\n            \"color\": \"#999999\",\n            \"margin\": \"xs\"\n          }\n        ]\n      },\n      {\n        \"type\": \"button\",\n        \"action\": {\n          \"type\": \"uri\",\n          \"label\": \"通話\",\n          \"uri\": person.link\n        },\n        \"style\": \"primary\",\n        \"color\": \"#00B900\",\n        \"height\": \"sm\", \n        \"flex\": 1,      \n        \"gravity\": \"center\"\n      }\n    ],\n    \"margin\": \"md\",\n    \"spacing\": \"sm\",\n    \"alignItems\": \"center\"\n  });\n\n  // 分隔線\n  if (index < uniqueData.length - 1) {\n    listContents.push({\n      \"type\": \"separator\",\n      \"margin\": \"md\",\n      \"color\": \"#EEEEEE\"\n    });\n  }\n});\n\nconst finalFlex = {\n  \"type\": \"bubble\",\n  \"size\": \"mega\",\n  \"header\": {\n    \"type\": \"box\",\n    \"layout\": \"vertical\",\n    \"backgroundColor\": \"#F8F8F8\",\n    \"contents\": [\n      {\n        \"type\": \"text\",\n        \"text\": \"📞 聯絡專員名單\",\n        \"weight\": \"bold\",\n        \"size\": \"md\",\n        \"color\": \"#1DB446\"\n      }\n    ]\n  },\n  \"body\": {\n    \"type\": \"box\",\n    \"layout\": \"vertical\",\n    \"contents\": listContents,\n    \"paddingAll\": \"md\"\n  }\n};\n\nreturn {\n  flexJsonString: JSON.stringify(finalFlex)\n};"
      },
