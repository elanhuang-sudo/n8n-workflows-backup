    {
      "parameters": {
        "jsCode": "// 取得上一個節點的 JSON 資料\nconst input = items[0].json;\nconst clients = input[\"客戶名稱\"];\nconst links = input[\"加買發票連結\"];\n\n// 1. 動態生成按鈕陣列\nconst buttons = clients.map((name, index) => {\n  return {\n    \"type\": \"button\",\n    \"action\": {\n      \"type\": \"uri\",\n      \"label\": name, // 按鈕文字顯示客戶名稱\n      \"uri\": links[index] // 點擊跳轉對應連結\n    },\n    \"style\": \"primary\",\n    \"margin\": \"sm\"\n  };\n});\n\n// 2. 組裝成完整的 Flex Message 結構\nconst flexContent = {\n  \"type\": \"bubble\",\n  \"header\": {\n    \"type\": \"box\",\n    \"layout\": \"vertical\",\n    \"contents\": [\n      {\n        \"type\": \"text\",\n        \"text\": \"📋 加買發票申請\",\n        \"weight\": \"bold\",\n        \"size\": \"lg\",\n        \"color\": \"#1DB446\"\n      }\n    ]\n  },\n  \"body\": {\n    \"type\": \"box\",\n    \"layout\": \"vertical\",\n    \"contents\": [\n      {\n        \"type\": \"text\",\n        \"text\": \"請選擇對應的單位進行填寫：\",\n        \"size\": \"sm\",\n        \"color\": \"#666666\",\n        \"wrap\": true\n      },\n      ...buttons // 將剛剛生成的按鈕清單展開放入\n    ]\n  }\n};\n\n// ...前面的代碼不變\n\n// 輸出時，務必加上 JSON.stringify() 並將其包在一個新的物件屬性中\nreturn {\n  flexJsonString: JSON.stringify(flexContent)\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
