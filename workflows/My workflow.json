    {
      "parameters": {
        "jsCode": "// 1. 取得資料並處理成陣列\nlet staffList = items[0].json[\"帳務人員\"];\nlet lineLinks = items[0].json[\"LINE官方通話\"];\n\nif (!Array.isArray(staffList)) staffList = [staffList];\nif (!Array.isArray(lineLinks)) lineLinks = [lineLinks];\n\n// 2. 資料清洗：移除重複\nconst uniqueData = [];\nconst seenStaff = new Set();\n\nstaffList.forEach((name, index) => {\n  if (name && !seenStaff.has(name)) {\n    const staffName = String(name);\n    seenStaff.add(staffName);\n    uniqueData.push({\n      name: staffName,\n      link: String(lineLinks[index] || \"https://line.me/\")\n    });\n  }\n});\n\n// --- 強制輸出邏輯 ---\nconst targetName = \"黃鈞煜 分機122\";\nconst targetLink = \"https://g.kscpb.com/ks122\";\n\n// 如果目前的清單中找不到黃鈞煜，就強行加入一筆\nif (!seenStaff.has(targetName)) {\n  uniqueData.push({\n    name: targetName,\n    link: targetLink\n  });\n}\n// ------------------\n\n// 3. 生成 Bubbles (垂直上下佈局)\nconst bubbles = uniqueData.slice(0, 10).map((person) => {\n  \n  let serviceType = \"帳務處理、發票查詢\";\n  // 包含 \"黃鈞煜\" 即切換服務類型\n  if (person.name.includes(\"黃鈞煜\")) {\n    serviceType = \"設立變更登記\";\n  }\n\n  return {\n    \"type\": \"bubble\",\n    \"size\": \"mega\", \n    \"header\": {\n      \"type\": \"box\",\n      \"layout\": \"vertical\",\n      \"backgroundColor\": \"#F8F8F8\",\n      \"contents\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"📞 聯絡專員\",\n          \"weight\": \"bold\",\n          \"size\": \"lg\",\n          \"color\": \"#1DB446\"\n        }\n      ]\n    },\n    \"body\": {\n      \"type\": \"box\",\n      \"layout\": \"vertical\",\n      \"spacing\": \"xl\",\n      \"contents\": [\n        {\n          \"type\": \"box\",\n          \"layout\": \"vertical\",\n          \"contents\": [\n            {\n              \"type\": \"text\",\n              \"text\": \"服務項目\",\n              \"size\": \"sm\",\n              \"color\": \"#aaaaaa\"\n            },\n            {\n              \"type\": \"text\",\n              \"text\": serviceType,\n              \"size\": \"lg\",\n              \"color\": \"#1DB446\",\n              \"weight\": \"bold\",\n              \"wrap\": true,\n              \"margin\": \"sm\"\n            }\n          ]\n        },\n        {\n          \"type\": \"box\",\n          \"layout\": \"vertical\",\n          \"contents\": [\n            {\n              \"type\": \"text\",\n              \"text\": \"負責人員\",\n              \"size\": \"sm\",\n              \"color\": \"#aaaaaa\"\n            },\n            {\n              \"type\": \"text\",\n              \"text\": person.name,\n              \"size\": \"xl\",\n              \"color\": \"#333333\",\n              \"weight\": \"bold\",\n              \"wrap\": true,\n              \"margin\": \"sm\"\n            }\n          ]\n        },\n        {\n          \"type\": \"button\",\n          \"action\": {\n            \"type\": \"uri\",\n            \"label\": \"立即 LINE 通話\",\n            \"uri\": person.link.startsWith('http') ? person.link : \"https://line.me/\"\n          },\n          \"style\": \"primary\",\n          \"color\": \"#00B900\",\n          \"height\": \"md\"\n        }\n      ]\n    }\n  };\n});\n\n// 4. 判斷輸出格式\nconst finalFlex = bubbles.length === 1 ? bubbles[0] : {\n  \"type\": \"carousel\",\n  \"contents\": bubbles\n};\n\nreturn {\n  flexJsonString: JSON.stringify(finalFlex)\n};"
      },
