      "id": "c6cbc415-bf39-40d5-b640-930eff390fed",
      "name": "LINE Webhook",
      "webhookId": "cacc050c-52c9-400a-88f9-63ee24948dc3"
    },
    {
      "parameters": {
        "jsCode": "// 1. 取得 LINE 傳來的訊息\nconst body = $input.first().json.body;\nconst events = body.events || [];\n\nif (events.length === 0) {\n  return { json: { status: \"no_events\" } };\n}\n\nconst event = events[0];\n// 只處理文字訊息且排除機器人自己\nif (event.type !== 'message' || event.message.type !== 'text') {\n  return { json: { status: \"ignored\" } };\n}\n\nconst userMessage = event.message.text;\nconst replyToken = event.replyToken;\nconst userId = event.source.userId;\n\n// 2. 使用 n8n 的 Static Data 記憶體暫存對話\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.messages) {\n    staticData.messages = [];\n}\n\n// 放入新訊息\nstaticData.messages.push({\n    user: userId,\n    text: userMessage,\n    time: new Date().toISOString()\n});\n\n// 限制最多保留最近 50 則訊息，避免記憶體過大\nif (staticData.messages.length > 50) {\n    staticData.messages.shift();\n}\n\n// 3. 檢查是否被標記 (@) 或者是輸入特定指令來觸發機器人回應\nconst isTriggered = userMessage.includes('@機器人') || userMessage.includes('總結') || userMessage.includes('笑話');\n\n// 組合要給 Gemini 的對話上下文\nconst allChatHistory = staticData.messages.map(m => `${m.text}`).join('\\n');\n\nreturn {\n  json: {\n    replyToken,\n    userMessage,\n    allChatHistory,\n    isTriggered\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
        -64
      ],
      "id": "6d30c2b9-f3fe-4593-bc23-70f1b10323e2",
      "name": "處理訊息與快取"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
